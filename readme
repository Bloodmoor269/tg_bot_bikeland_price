Debian Trixie (Raspberry Pi Desktop)

Turn off Plymouth
######################################################################################################
sudo nano /etc/default/grub

GRUB_CMDLINE_LINUX_DEFAULT="quiet splash plymouth.enable=0"
######################################################################################################

sudo apt update -y; sudo apt upgrade -y

mkdir /home/user/tg_bot

download bot.py and paste to tg_bot/

python -m venv /home/user/tg_bot

source /home/user/tg_bot/bin/activate

pip install requests lxml beautifulsoup4 python-telegram-bot apscheduler

sudo nano /etc/systemd/system/tg-price-bot.service

######################################################################################################
[Unit]
Description=Telegram Price Tracker Bot
# Ждём, пока поднимется сеть и VPN (если VPN оформлен как сервис)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uid0001
Group=uid0001
# Папка, где лежит bot.py и ваша база данных
WorkingDirectory=/home/uid0001/Desktop/tg_bot
# ⏳ Пауза 60 секунд перед запуском
ExecStartPre=/bin/sleep 60
# 🔑 Путь к python из вашего виртуального окружения и скрипт бота
# Проверьте, что путь к python правильный
ExecStart=/home/uid0001/Desktop/tg_bot/bin/python /home/uid0001/Desktop/tg_bot/bot.py
# Автоматически перезапускать при падении
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
######################################################################################################

######################################################################################################
# Перечитываем конфигурацию systemd
sudo systemctl daemon-reload

# Включаем автозапуск и сразу стартуем (но запуск произойдёт через 60 сек)
sudo systemctl enable --now tg-price-bot.service
######################################################################################################
